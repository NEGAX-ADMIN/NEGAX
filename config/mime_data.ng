    single_mime=MimeBuilder(
        mime_type=MIME_TYPE.MULTIPART_ALT,
        dkim_sign_email=DkimConfig(
            enabled=1,
            use_fixed_key=False,
            generate_per_email=True,
        ),
        raw_mime=RawMimeData(
            enabled=False,
            mime_file="inputs/sample.eml",
            remove_attachments=True,
        ),
        save_mime=SaveMimeData(
            enabled=0,
            save_eml=True,
            save_xml=True,
            output_dir="outputs/mime",
            file_name="{{email}}_{{rstr8}}.eml",
        ),
        body_encoding=BodyEncoding.BASE64,
        boundary=MimeBoundaryConfig(
            enabled=True,
            value="----TEST-BOUNDARY-{{rstr6}}----",
        ),
        x_priority=MimeValueConfig(
            enabled=0,
            value=MIME_PRIORITY.HIGH_NUMERIC,
        ),
        from_header=MimeValueConfig(
            enabled=True,
            value=MIME_FROM.GENERAL_FROMMAIL,
        ),
        to_header=MimeValueConfig(
            enabled=True,
            value=MIME_TO.EMAIL_ONLY,
        ),
        subject_header=MimeValueConfig(
            enabled=True,
            value=MIME_SUBJECT.DEFAULT_SUBJECT,
        ),
        randomize_headers=True,
    ),
    cache_built_models=MIME_CACHE_METHOD.DUPLICATE,
)
