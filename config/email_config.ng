SendLoopConfig(
    enabled=1,
    benchmark_enabled=1,
    benchmark_show_summary=1,
    batch_size=2,
    delay_between_emails=5,
    delay_between_emails_unit=1,
    delay_between_batches=10,
    delay_between_batches_unit=1,
    save_results=SendResultSaveConfig(
        enabled=0,
        save_sent=1,
        save_failed=1,
    ),
    debug_delays=0,
    progress=SendProgressConfig(
        enabled=1,
        use_table=0,
        use_colors=1,
        show_time=1,
        show_status=1,
        show_counter=1,
        show_recipient=1,
        show_subject=1,
        show_transport=1,
        show_transport_type=1,
        show_error=1,
        left_padding=3,
    ),
)


enabled_worker_threads = 0
worker_threads = 4
