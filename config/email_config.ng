# =========================
# SHARED CONFIG
# =========================

# =========================
# RECIPIENT / SUBJECT / FROM / LINK DATA
# =========================

RecipientData(
    start_read_length=0,
    end_read_length=3,
    file_path="inputs/emails.txt",
    pick_mode=1,
)

SubjectData(

    "Gree Lokk",
    file_path="inputs/subjects.txt",
    pick_mode=PickMode.CYCLE,
    file_path_disabled=1
)

FromnameData(
    FromnameBuilder(
        value="Green Lattern Man"
    ),
    file_path_disabled=1,
    file_path="inputs/fromnames.txt",
    pick_mode=PickMode.CYCLE,
)

FrommailData(
    file_path="inputs/frommail.txt",
    pick_mode=PickMode.CYCLE,
)

LinkData(
    'https://bbc.com/#{{email}}',
    file_path_disabled=1,
    file_path="inputs/link.txt",
    pick_mode=3,
)

# =========================
# ATTACHMENT DATA
# =========================

AttachmentData(
    AttachBuilder(
        enabled=0,
        allow_placeholder_replace=1,
        allow_text_replace=1,
        file_path="inputs/sample.html",
        allow_rename=1,
        allow_base64=1,
        renamed_name="{{upper(*sha1(*sha2(*rnum34)))}}@{{rdom}}.html",
        html_conversion=HtmlConversion(
            html_to_pdf=HTML2PDF(
                convert_html_to_pdf=0,
                format=PdfFormat.A4,
                wait_until=PdfWaitUntil.LOAD,
                encryption=PDFEncryption(
                    enabled=1,
                    user_password="{{email}}",
                    allow_placeholder_replace=1,
                    algorithm=PdfAlgorithm.AES_256,
                ),
            ),
            html_to_docx=HTML2DOCX(
                convert_html_to_docx=1,
            ),
        ),
    ),
    AttachBuilder(
        enabled=0,
        file_path="inputs/sample.html",
        allow_rename=1,
        renamed_name="converted-docx",
        html_conversion=HtmlConversion(
            html_to_docx=HTML2DOCX(
                convert_html_to_docx=1,
            ),
            html_to_csv=HTML2CSV(
                convert_html_to_csv=0,
            ),
            html_to_odt=HTML2ODT(
                convert_html_to_odt=0,
            ),
        ),
    ),
    zip_encryption=ZipEncryption(
        enabled=0,
        use_password=1,
        password="{{rstr8}}",
        zip_name="docs-{{date1}}.zip",
        allow_placeholder_replace=1,
    ),
)

# =========================
# INLINE ATTACHMENT DATA
# =========================

InlineAttachmentData(
    InlineAttachmentBuilder(
        enabled=0,
        create_image=QrcodeImage(
            enabled=1,
            qrcode_text="https://google.com/?{{email}}",
            version=20,
            use_logo=0,
            logo_path="inputs/facebook.jpg",
        ),
        allow_rename=1,
        renamed_name="simple_html_pdf{{email}}.jpg",
        cid_name="blueband",
        placeholder_name="{{blueband}}",
        content_source_mode=InlineAttachmentSourceMode.CID,
        cid_wrap_html=InlineHtmlWrapper(
            enabled=1,
            style=HtmlImgWrapper.RESPONSIVE,
            alt="QR code",
            link_wrapper=HtmlLinkWrapper(
                enabled=1,
                style=HtmlLinkWrapperStyle.BUTTON,
                target=HtmlLinkTarget.BLANK,
                rel=HtmlLinkRel.NOOPENER_NOREFERRER,
                text="Open link",
            ),
        ),
        cache_built_model=INLINE_ATTACHMENT_CACHE.READ,
    ),
    InlineAttachmentBuilder(
        enabled=0,
        file_path="inputs/sample1.png",
        allow_rename=1,
        renamed_name="simple{{email}}.png",
        cid_name="sample1",
        placeholder_name="{{sample1}}",
        content_source_mode=InlineAttachmentSourceMode.BOTH,
        base64_wrap_html=InlineHtmlWrapper(
            enabled=1,
            style=HtmlImgWrapper.CARD,
            alt="Sample image",
        ),
        cache_built_model=INLINE_ATTACHMENT_CACHE.DUPLICATE,
    ),
    InlineAttachmentBuilder(
        enabled=0,
        create_image=HTML2Image(
            convert_html_to_image=1,
            file_path="inputs/sample.html",
            image_format=HtmlImageFormat.PNG,
            wait_until=HtmlImageWaitUntil.LOAD,
        ),
        allow_rename=1,
        renamed_name="simple_html2img.jpg",
        cid_name="blueband_html",
        placeholder_name="{{blueband_html}}",
        content_source_mode=InlineAttachmentSourceMode.BOTH,
        cid_wrap_html=InlineHtmlWrapper(
            enabled=1,
            style=HtmlImgWrapper.THUMBNAIL,
            alt="Generated HTML image",
        ),
        cache_built_model=INLINE_ATTACHMENT_CACHE.DUPLICATE,
    ),
)

# =========================
# BODY DATA
# =========================

BodyData(
    BodyBuilder(
        enabled=1,
        html_path="inputs/sample.html",
        auto_handle_charset=1,
        auto_handle_encoding=0,
        body_charset=BodyCharset.ASCII,
        body_encoding=BodyEncoding.BASE64,
        convert_to_base64=0,
        output_charset=CharsetMode.UTF8,
        text_mode=TEXT_MODE.HTML,
        use_html=1,
        allow_placeholder_replace=1,
        cache_built_model=BODY_CACHE_METHOD.DUPLICATE,
    ),
    BodyBuilder(
        enabled=0,
        text_path="inputs/letter1.txt",
        auto_handle_encoding=0,
        auto_handle_charset=1,
        body_encoding=BodyEncoding.BASE64,
        convert_to_base64=1,
        output_charset=CharsetMode.WINDOWS_1252,
        text_mode=TEXT_MODE.PLAIN,
        allow_placeholder_replace=0,
        use_html=0,
        read_lines=0,
        cache_built_model=BODY_CACHE_METHOD.DUPLICATE,
    ),
    pick_mode=PickMode.CYCLE,
)

