# =========================
# SHARED CONFIG
# =========================

# =========================
# RECIPIENT / SUBJECT / FROM / LINK DATA
# =========================

RecipientData(
    start_read_length=None,
    end_read_length=10,
    file_path="inputs/emails.txt",
    pick_mode=1,
)

SubjectData(
    "Gree Lokk",
    file_path="inputs/subjects.txt",
    pick_mode=3,
    file_path_disabled=1
)

FromnameData(
    FromnameBuilder(
        value="Green Lattern Man"
    ),
    file_path_disabled=1,
    file_path="inputs/fromnames.txt",
    pick_mode=3,
)

FrommailData(
    file_path="inputs/frommail.txt",
    pick_mode=3,
)

LinkData(
    'https://bbc.com/#{{email}}',
    file_path_disabled=1,
    file_path="inputs/link.txt",
    pick_mode=3,
)

# =========================
# ATTACHMENT DATA
# =========================

AttachmentData(
    AttachBuilder(
        enabled=1,
        file_path="inputs/sample.html",
        renamed_name="{{upper(*sha1(*sha2(*rnum34)))}}@{{rdom}}.html",
        html_conversion=HtmlConversion(
            html_to_pdf=HTML2PDF(
                convert_html_to_pdf=0,
                encryption=PDFEncryption(
                    enabled=1,
                    user_password="{{email}}",
                ),
            ),
            html_to_docx=HTML2DOCX(
                convert_html_to_docx=1,
            ),
        ),
    ),
    AttachBuilder(
        enabled=0,
        file_path="inputs/acac.html",
        renamed_name="converted-docx{{emaill}}",
        html_conversion=HtmlConversion(
            html_to_docx=HTML2DOCX(
                convert_html_to_docx=1,
            ),
            html_to_csv=HTML2CSV(
                convert_html_to_csv=0,
            ),
            html_to_odt=HTML2ODT(
                convert_html_to_odt=0,
            ),
        ),
    ),
    zip_encryption=ZipEncryption(
        enabled=0,
        use_password=1,
        password="{{rstr8}}",
        zip_name="docs-{{date1}}.zip",
    ),
)

# =========================
# INLINE ATTACHMENT DATA
# =========================

InlineAttachmentData(
    InlineAttachmentBuilder(
        enabled=0,
        create_image=QrcodeImage(
            enabled=1,
            qrcode_text="https://google.com/?{{email}}",
            version=20,
            use_logo=0,
            logo_path="inputs/facebook.jpg",
        ),
        renamed_name="simple_html_pdf{{email}}.jpg",
        cid_name="blueband",
        placeholder_name="{{blueband}}",

    ),
    InlineAttachmentBuilder(
        enabled=0,
        file_path="inputs/sample1.png",
        renamed_name="simple{{email}}.png",
        cid_name="sample1",
        placeholder_name="{{sample1}}",
        content_source_mode=InlineAttachmentSourceMode.BOTH,
    ),
    InlineAttachmentBuilder(
        enabled=0,
        create_image=HTML2Image(
            convert_html_to_image=1,
            file_path="inputs/sample.html",
            image_format=HtmlImageFormat.PNG,
            wait_until=HtmlImageWaitUntil.LOAD,
        ),
        renamed_name="simple_html2img.jpg",
        cid_name="blueband_html",
        placeholder_name="{{blueband_html}}",
    ),
)

# =========================
# BODY DATA
# =========================

BodyData(
    BodyBuilder(
        enabled=1,
        html_path="inputs/html_letters",
        body_charset=2,
        body_encoding=1,
        output_charset=1,
        text_mode=TEXT_MODE.HTML,
    ),
    BodyBuilder(
        enabled=1,
        text_path="inputs/text_letters",
        body_encoding=3,
        convert_to_base64=1,
        output_charset=4,
        text_mode=TEXT_MODE.PLAIN,
    ),
    pick_mode=3,
)

# =========================
# LOGO RESOLVER
# =========================

LogoResolverConfig(
    enabled=1,
    provider=2,
    brandfetch_token="YOUR-BRANDFETCH-TOKEN",
)


# =========================
# SEND LOOP / WORKERS
# =========================

SendLoopConfig(
    enabled=1,
    batch_size=5,
    delay_between_emails=0,
    delay_between_emails_unit=1,
    delay_between_batches=1,
    delay_between_batches_unit=1,
    send_timeout_seconds=120,
    watchdog_enabled=0,
    watchdog_interval_seconds=5,
    watchdog_stall_seconds=180,
    watchdog_memory_logging=0,
    save_results=SendResultSaveConfig(
        enabled=0,
        save_sent=1,
        save_failed=1,
    ),
)


enabled_worker_threads = 0
worker_threads = 5
